# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored and must never be committed.

# Gmail address CryptVault uses to send OTP verification emails
CRYPTVAULT_SMTP_EMAIL=your_email@gmail.com

# Gmail "App Password" for the above account (NOT your normal Gmail password)
# Generate one at: https://myaccount.google.com/apppasswords
CRYPTVAULT_SMTP_APP_PASSWORD=your_16_char_app_password
